{
  "name": "aimator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aimator": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "simple-git-hooks",
    "site:build": "tsx src/site/build.ts",
    "site:deploy": "pnpm site:build && pnpm site:media && wrangler deploy --config wrangler.site.jsonc",
    "site:freeze": "tsx src/site/freeze.ts",
    "site:media": "tsx src/site/publish.ts",
    "site:preview": "pnpm site:build && wrangler dev --config wrangler.site.jsonc --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "unused": "knip",
    "update": "taze --interactive"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm test",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.7",
    "knip": "^5.88.1",
    "semantic-release": "^25.0.9",
    "simple-git-hooks": "^2.14.0",
    "taze": "^19.17.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "ultracite": "^7.12.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "knip": {
    "project": [
      "src/**/*.ts"
    ],
    "ignoreDependencies": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
