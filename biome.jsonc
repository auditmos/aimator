{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  // `out/` is the built site and `dist/` the built package: generated bytes, not
  // sources. `site/assets/` is vendored: brand wordmarks and webfonts copied from
  // the branding repository, which the design manual says not to redraw.
  "files": {
    "includes": ["!out", "!dist", "!site/assets"]
  },
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedImports": "warn"
      },
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  // Only the browser files under `site/` need blanket exceptions; everything
  // under `src/` carries its reason on the line it applies to, as the rest of
  // this repository does.
  "overrides": [
    {
      // Two exceptions, both about what these files are. `index.html` is a
      // template the build rewrites by string substitution (`<!-- RELEASES -->`,
      // the canonical URL, the `<title>`), so a formatter that reflows a tag
      // across lines silently changes what those substitutions see; the build's
      // own guard caught exactly that once, and refusing is not a reason to keep
      // the hazard. `jak-to-powstaje.html` carries an inline SVG whose `<text>`
      // nodes render the whitespace they contain, so reflowing them changes the
      // drawing. And `theme.js` and `lang.js` are blocking scripts by design:
      // each decides what the first paint looks like, so deferring either one
      // is the flash of the wrong theme or language it prevents.
      "includes": ["site/*.html"],
      "assist": { "enabled": false },
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "performance": { "noSyncScripts": "off" }
        }
      }
    },
    {
      // The stylesheet is ordered by the document it styles rather than by
      // specificity, which is what lets a rule be found next to the markup it
      // belongs to. The later, less specific rules are deliberate overrides.
      "includes": ["site/styles.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      // One function decides the language for the whole page; splitting it
      // would spread that decision across files instead of hiding it in one.
      "includes": ["site/lang.js"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    }
  ]
}
