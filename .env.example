# Copy to .env and adjust. .env is gitignored; this file is the committed reference.

# Where generated artifacts live. Kept outside the repo on purpose: a project
# holds hundreds of megabytes of images and video. A leading ~/ is expanded.
AIMATOR_WORKSPACE=~/Documents/Video/aimator-workspace

# Stage 1 (screenplay) — the first stage that spends money.
# Both are optional: `--dry-run` validates inputs and prints the exact prompt
# without either of them, and neither has a default, because a model nobody
# chose is not a decision this tool gets to make on your behalf.
AIMATOR_SCREENPLAY_MODEL=gpt-6-astra
OPENAI_API_KEY=sk-place-your-key-in-.env.local

# Stage 2 (character) — the first image stage, and the first to branch into two
# model tracks. One model variable per track, so both can run from one shell.
# Neither has a default, for the same reason stage 1's does not.
AIMATOR_IMAGE_MODEL_GPT_IMAGE=gpt-image-2.5-sunburst
AIMATOR_IMAGE_MODEL_SEEDREAM=dola-seedream-5-0-pro-260628

# The seedream track's key. Image generation on BytePlus takes a plain bearer
# token; the AccessKey/Secret signature belongs to their asset-library API,
# which this pipeline does not call.
BYTEPLUS_MODELARK=place-your-key-in-.env.local
