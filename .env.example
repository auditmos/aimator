# Copy to .env and adjust. .env is gitignored; this file is the committed reference.

# Where generated artifacts live. Kept outside the repo on purpose: a project
# holds hundreds of megabytes of images and video. A leading ~/ is expanded.
AIMATOR_WORKSPACE=~/Documents/Video/aimator-workspace

# Stage 1 (screenplay) — the first stage that spends money.
# Both are optional: `--dry-run` validates inputs and prints the exact prompt
# without either of them, and neither has a default, because a model nobody
# chose is not a decision this tool gets to make on your behalf.
AIMATOR_SCREENPLAY_MODEL=gpt-6-astra
OPENAI_API_KEY=sk-place-your-key-in-.env.local

# Stage 3 (shot list) — the second paid text stage, and the first artifact both
# image tracks share. Its own variable, not the screenplay's: a shared one would
# mean that choosing a model for stage 1 silently chose one for stage 3 too.
AIMATOR_SHOTLIST_MODEL=gpt-6-astra

# Stage 4 (prompt package) — the third paid text stage, and the first that waits
# on an image: it refuses to spend until every character the shot list puts on
# screen has an approved hero.png on BOTH image tracks. Its own variable, for the
# same reason stage 3 has one rather than reusing stage 1's.
AIMATOR_PROMPTS_MODEL=gpt-6-astra

# Stage 2 (character) — the first image stage, and the first to branch into two
# model tracks. One model variable per track, so both can run from one shell.
# Neither has a default, for the same reason stage 1's does not.
AIMATOR_IMAGE_MODEL_GPT_IMAGE=gpt-image-2.5-sunburst
AIMATOR_IMAGE_MODEL_SEEDREAM=dola-seedream-5-0-pro-260628

# The seedream track's key. Image generation on BytePlus takes a plain bearer
# token; the AccessKey/Secret signature belongs to their asset-library API,
# which this pipeline does not call.
BYTEPLUS_MODELARK=place-your-key-in-.env.local

# Stage 7 (clips) — the first stage that buys video, and the most expensive one.
# ONE variable for both tracks, unlike the image models above: a clip is not
# drawn side by side, it is rendered from the entry frame its own track already
# produced. No default, for the same reason none of the others has one.
# The key is BYTEPLUS_MODELARK on both tracks, including gpt-image.
AIMATOR_VIDEO_MODEL=dreamina-seedance-2-5-260628

# Stage 8 (assembly) — the first stage that buys nothing. It concatenates the
# approved clips into <track>/episode.mp4 with a stream copy: both tracks render
# at one resolution and frame rate from one video model, so nothing is
# re-encoded and no frame a human accepted is replaced. A missing ffmpeg is a
# refusal, never a fallback — `check` needs none of it, because it reads the
# MP4's own boxes. Optional: the usual answer is `ffmpeg` on PATH, and this
# points at a build that is not there rather than at a different tool.
AIMATOR_FFMPEG=ffmpeg

# Stage 9 (soundtrack) — the first stage that buys from two providers. One
# variable per call site, as everywhere: this one is the text model that lifts
# the narration script out of the approved screenplay and shot list.
AIMATOR_NARRATION_MODEL=gpt-6-astra

# The speech model stage 9 reads the narration with. ONE variable for both
# tracks, like the video model and for the same reason: a spoken sentence is not
# drawn, so a voice has no idea which of the two films it will sit over.
# It is the model, never the voice — which voice reads the series is stored in
# project.json beside the cast, because it recurs across episodes.
AIMATOR_VOICE_MODEL=eleven_multilingual_v2

# The speech key. Read only on the paid path; `--dry-run` never asks for it.
# Stage 10 uses the same one: the key follows the provider, while the variables
# below follow the call site.
ELEVENLABS_API_KEY=place-your-key-in-.env.local

# Stage 10 (sound design) — music and effects, and the film with everything in
# it. Three variables, because three paid call sites. This one is the text model
# that writes the cue sheet out of the approved shot list; the sheet is an
# INSTRUCTION, so it comes back in English while the shot list it was written
# from stays in the film's own language.
AIMATOR_SOUND_MODEL=gpt-6-astra

# The two audio models, at ElevenLabs. ONE variable each for BOTH tracks, like
# the video model and the voice: neither a bed nor a thunderclap is drawn, so
# neither knows which of the two films it will sit under. Two variables rather
# than one, because a shared one would mean that choosing how the score sounds
# quietly chose how a thunderclap does. Note what these are rated on: ElevenLabs
# charges per MINUTE of generated audio, at generation rather than at download —
# so a --regenerate is a second full charge, and every preview prints seconds
# beside the count of calls.
AIMATOR_MUSIC_MODEL=music_v2
AIMATOR_EFFECTS_MODEL=eleven_text_to_sound_v2
